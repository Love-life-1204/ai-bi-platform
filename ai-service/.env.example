AI_ENV=local
AI_BIND_HOST=127.0.0.1
AI_BIND_PORT=8091
AI_JAVA_BASE_URL=http://127.0.0.1:8080
AI_SHARED_SECRET=replace-with-at-least-32-random-characters
AI_CHECKPOINT_BACKEND=sqlite
AI_CHECKPOINT_SQLITE_PATH=./var/checkpoints.sqlite3
AI_TASK_DB_PATH=./var/tasks.sqlite3
AI_TOTAL_TIMEOUT_SECONDS=60
AI_NODE_TIMEOUT_SECONDS=12
AI_MAX_TOOL_CALLS=8
AI_MAX_WORKERS=4
# 生产必须使用独立持久化 Redis，并安装 [redis] 可选依赖。
# AI_CHECKPOINT_BACKEND=redis
# AI_CHECKPOINT_REDIS_URL=redis://checkpoint-redis:6379/0

