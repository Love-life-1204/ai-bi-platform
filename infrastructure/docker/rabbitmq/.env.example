RABBITMQ_ADMIN_USER=aibi_admin
RABBITMQ_ADMIN_PASSWORD=replace-with-long-random-admin-secret
RABBITMQ_APP_USER=aibi_app
RABBITMQ_APP_PASSWORD=replace-with-long-random-app-secret
RABBITMQ_VHOST=/aibi
RABBITMQ_TLS_PORT=5671
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_TRUST_STORE_PASSWORD=replace-with-local-trust-store-secret
