SPRING_PROFILES_ACTIVE=local
ANALYTICS_ENABLED=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_bi_core
MYSQL_APP_USER=aibi_api
MYSQL_APP_PASSWORD=replace-with-local-secret

CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=ai_bi_dws
CLICKHOUSE_APP_USER=aibi_reader
CLICKHOUSE_APP_PASSWORD=replace-with-local-secret
CLICKHOUSE_WRITER_DATABASE=ai_bi_raw
CLICKHOUSE_WRITER_USER=aibi_ingestion_worker
CLICKHOUSE_WRITER_PASSWORD=replace-with-local-secret

RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5671
RABBITMQ_VHOST=/aibi
RABBITMQ_USERNAME=aibi_app
RABBITMQ_PASSWORD=replace-with-rabbitmq-app-secret
RABBITMQ_SSL_ENABLED=true
RABBITMQ_TRUST_STORE=file:../infrastructure/docker/rabbitmq/client/ca.p12
RABBITMQ_TRUST_STORE_PASSWORD=replace-with-trust-store-secret

# Base64 编码的 32 字节 AES 主密钥；生产环境必须由 KMS/Secret Manager 注入。
DATASOURCE_MASTER_KEY=replace-with-base64-encoded-32-byte-key
# 仅在网络侧已经建立专线、Agent 或明确白名单时开启。
DATASOURCE_ALLOW_PRIVATE_NETWORK=false
DATASOURCE_ALLOWED_PORTS=3306,5432
AI_SERVICE_URL=http://127.0.0.1:8091
AI_SHARED_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-payment-provider-webhook-secret
PLATFORM_OPERATIONS_TOKEN=replace-with-platform-operations-token
COMMERCIAL_INTERNAL_TOKEN=replace-with-internal-service-token
COMMERCIAL_QUOTA_ENFORCEMENT=true
APP_COMMERCIAL_OIDC_SECRETS_0_REF=primary-oidc
APP_COMMERCIAL_OIDC_SECRETS_0_VALUE=replace-with-oidc-client-secret
COMMERCIAL_EMAIL_ENABLED=true
COMMERCIAL_EMAIL_FROM=reports@example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-smtp-user
SPRING_MAIL_PASSWORD=replace-with-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
